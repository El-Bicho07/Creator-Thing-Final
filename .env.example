# ============================================
# Creator Platform SaaS - Environment Variables
# Copy to .env and fill in your values
# ============================================

# --------------------------------------------
# DATABASE (PostgreSQL + pgvector)
# --------------------------------------------
# Connection string for the primary database
# Format: postgresql+asyncpg://user:password@host:port/dbname
# For local development: use api_user (non-superuser, RLS enforced)
# For production: use Supabase service role or dedicated API user
DATABASE_URL=postgresql+asyncpg://api_user:api_password@localhost:5432/creator_platform
# ------------------------------------------------------------------
# Operational tooling ONLY (schema migrations, re-embedding, reconciliation).
# This role BYPASSES Row Level Security so one pass can process every creator.
# The API never uses it: it connects as the non-superuser `api_user`, so an
# application bug cannot read another creator's data.
# Never point the running application at this URL.
# ------------------------------------------------------------------
ADMIN_DATABASE_URL=postgresql+asyncpg://creator:changeme@localhost:5432/creator_platform

# --------------------------------------------
# SUPABASE AUTH
# --------------------------------------------
# Supabase project URL (e.g., https://xxxxx.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Supabase anon key (client-side safe, for frontend)
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase JWT secret (for backend token verification)
# Get this from Supabase Dashboard > Settings > API > JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret-here

# --------------------------------------------
# LLM PROVIDERS
# --------------------------------------------
# Primary: Google Gemini (recommended: gemini-2.5-flash)
GEMINI_API_KEY=your-gemini-api-key-here

# Fallback 1: Anthropic Claude
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Fallback 2: Groq (Llama 3.3 70B)
GROQ_API_KEY=your-groq-api-key-here

# Optional: OpenAI (for embeddings or alternative LLM)
# OPENAI_API_KEY=your-openai-api-key-here

# LLM Gateway Configuration
LLM_PROVIDER=mock
LLM_DEFAULT_PROVIDER=mock
LLM_DEFAULT_MODEL=mock-deterministic

# --------------------------------------------
# EMBEDDING SERVICE (ADR-002, Phase 2 selection)
# Selected: intfloat/multilingual-e5-base, 768 dimensions.
# E5 requires the "query: " / "passage: " prefixes; they are applied inside
# the EmbeddingService and must not be removed.
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_REVISION=d128750597153bb5987e10b1c3493a34e5a4502a
EMBEDDING_DIMENSION=768
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_SEQ_LENGTH=512
EMBEDDING_NORMALIZE=true
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_DOCUMENT_PREFIX="passage: "
EMBEDDING_VERSION=e5-base-v1

# --------------------------------------------
# EXTERNAL PLATFORMS (Optional - for content ingestion)
# --------------------------------------------
# YouTube Data API v3 (for transcript ingestion)
# YOUTUBE_API_KEY=your-youtube-api-key-here

# Instagram Graph API (for content import)
# INSTAGRAM_APP_ID=your-app-id
# INSTAGRAM_APP_SECRET=your-app-secret

# --------------------------------------------
# ANALYTICS & OBSERVABILITY (Optional)
# --------------------------------------------
# Sentry DSN for error tracking
# SENTRY_DSN=your-sentry-dsn

# --------------------------------------------
# APP SETTINGS
# --------------------------------------------
APP_ENV=development
LOG_LEVEL=debug
PORT=8000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here