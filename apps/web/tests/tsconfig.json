{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "jsx": "react-jsx",
    "noEmit": false,
    "outDir": "../.test-build",
    "rootDir": "..",
    "declaration": false,
    "sourceMap": false,
    "baseUrl": "..",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "../lib/**/*.ts",
    "../lib/**/*.tsx",
    "../app/today/page.tsx",
    "../app/studio/page.tsx",
    "../app/page.tsx"
  ]
}
